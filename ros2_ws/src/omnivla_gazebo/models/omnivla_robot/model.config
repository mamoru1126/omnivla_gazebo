<?xml version="1.0"?>
<model>
  <name>omnivla_robot</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Small differential-drive robot with a forward RGB camera (640x480, hfov 1.75 rad, height 0.35 m)
    and a ground-truth odometry publisher, used to run / fine-tune OmniVLA in Gazebo.
  </description>
</model>
