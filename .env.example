# cp .env.example .env して編集 (docker compose が自動で読む)
WORLD=office_0
HEADLESS=false
RVIZ=false
ROS_DOMAIN_ID=42
GZ_PARTITION=omnivla

# 大きなファイルの置き場所 (別ディスクにしたい場合は絶対パスで)
CHECKPOINT_DIR=./checkpoints
DATA_DIR=./data
RUNS_DIR=./runs

# navigator
GOAL_PATH=
FINETUNED_DIR=
MODALITY=image
# trajectory (既定: 予測軌跡をそのまま実行) | upstream (公式の式) | pure_pursuit
CONTROLLER=trajectory

# explore (自動データ収集)
EPISODES=50
SEED=0

# train
TRAIN_CONFIG=training/configs/finetune_gazebo.yaml
